{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/verify",
      "destination": "/verify.html"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "buildCommand": "echo \"no build step\"",
  "outputDirectory": "public",
  "installCommand": "npm install",
  "regions": [
    "sin1"
  ]
}
