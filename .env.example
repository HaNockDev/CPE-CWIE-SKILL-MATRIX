# ---- ความปลอดภัย (ต้องตั้งก่อนใช้งานจริง) ----
ADMIN_PASSWORD=change-me
APP_SECRET=long-random-string-at-least-32-chars

# ---- ฐานข้อมูล ----
# Hugging Face / เครื่องตัวเอง: ไม่ต้องตั้ง (ใช้ไฟล์ SQLite ที่ /data/exam.db หรือ ./data/exam.db)
# Vercel: ใช้ Turso (libSQL = SQLite บนคลาวด์)
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=...

# ---- อื่น ๆ ----
# EMAIL_DOMAIN=psru.ac.th
# PUBLIC_URL=https://exam.example.ac.th     # ใช้สร้างลิงก์ QR/อีเมล
# SEED_DEMO=0                                # ไม่สร้างรอบทดลองตอนเริ่มฐานข้อมูลใหม่
# SEED_SAMPLE_QUESTIONS=0                    # ไม่ใส่ข้อสอบตัวอย่าง

# ---- อีเมลสรุปผล (ไม่ตั้ง = เก็บไว้ในตาราง email_outbox เท่านั้น) ----
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=exam@psru.ac.th
# SMTP_PASS=app-password
# SMTP_FROM="ระบบสอบออนไลน์ PSRU <exam@psru.ac.th>"
